{
    "elements": [
        {
            "type": "Select",
            "name": "InputMode",
            "caption": "Input mode",
            "options": [
                {
                    "caption": "PIN",
                    "value": 0
                },
                {
                    "caption": "Pattern",
                    "value": 1
                }
            ],
            "onChange": "IPS_RequestAction($id, \"InputModePreview\", $InputMode);"
        },
        {
            "type": "CheckBox",
            "name": "BindToModuleCode",
            "caption": "Require re-registration after module code changes"
        },
        {
            "type": "Label",
            "caption": "Input mode and code binding are locked after the first action or Super PIN registration. Changing either requires a reset."
        },
        {
            "type": "Label",
            "caption": "When code binding is disabled, registrations survive compatible module updates. Code binding remains enabled by default."
        },
        {
            "type": "Label",
            "name": "ConfigurationError",
            "caption": "",
            "visible": false
        },
        {
            "type": "NumberSpinner",
            "name": "DelayAfterFailures",
            "caption": "Start delay after failed attempts",
            "minimum": 1,
            "maximum": 20
        },
        {
            "type": "NumberSpinner",
            "name": "BaseDelay",
            "caption": "Base delay",
            "suffix": " seconds",
            "minimum": 1,
            "maximum": 3600
        },
        {
            "type": "NumberSpinner",
            "name": "PermanentLockAfter",
            "caption": "Permanently lock after failed attempts",
            "minimum": 1,
            "maximum": 100
        },
        {
            "type": "NumberSpinner",
            "name": "InputTimeout",
            "caption": "Input timeout",
            "suffix": " seconds",
            "minimum": 5,
            "maximum": 300
        },
        {
            "type": "NumberSpinner",
            "name": "RecoveryAttempts",
            "caption": "Recovery attempts",
            "minimum": 1,
            "maximum": 20
        },
        {
            "type": "NumberSpinner",
            "name": "MessageDuration",
            "caption": "Display duration for temporary messages",
            "suffix": " seconds",
            "minimum": 1,
            "maximum": 60
        },
        {
            "type": "CheckBox",
            "name": "ScrambleKeypad",
            "caption": "Scramble digits"
        },
        {
            "type": "NumberSpinner",
            "name": "ScrambleInterval",
            "caption": "Scramble interval while idle (0 = disabled)",
            "suffix": " seconds",
            "minimum": 0,
            "maximum": 3600
        }
    ],
    "actions": [
        {
            "type": "Label",
            "caption": "Actions are imported from tested scripts or registered as visualization targets through PRACT_RegisterAction()."
        }
    ],
    "status": [
        {
            "code": 202,
            "icon": "error",
