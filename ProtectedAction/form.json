{
    "elements": [
        {
            "type": "Select",
            "name": "InputMode",
            "caption": "Input mode",
            "options": [
                {
                    "caption": "PIN",
                    "value": 0
                },
                {
                    "caption": "Pattern",
                    "value": 1
                }
            ]
        },
        {
            "type": "CheckBox",
            "name": "BindToModuleCode",
            "caption": "Require re-registration after module code changes"
        },
        {
            "type": "Label",
            "caption": "Input mode and code binding are locked after the first action or Super PIN registration. Changing either requires a reset."
        },
        {
            "type": "Label",
            "caption": "When code binding is disabled, registrations survive compatible module updates. Code binding remains enabled by default."
        },
        {
            "type": "Label",
            "name": "ConfigurationError",
            "caption": "",
            "visible": false
        },
        {
            "type": "NumberSpinner",
            "name": "DelayAfterFailures",
            "caption": "Start delay after failed attempts",
            "minimum": 1,
            "maximum": 20
        },
        {
            "type": "NumberSpinner",
            "name": "BaseDelay",
            "caption": "Base delay",
            "suffix": " seconds",
            "minimum": 1,
            "maximum": 3600
        },
        {
            "type": "NumberSpinner",
            "name": "PermanentLockAfter",
            "caption": "Permanently lock after failed attempts",
            "minimum": 1,
            "maximum": 100
        },
        {
            "type": "NumberSpinner",
            "name": "InputTimeout",
            "caption": "Input timeout",
            "suffix": " seconds",
            "minimum": 5,
            "maximum": 300
        },
        {
            "type": "NumberSpinner",
            "name": "RecoveryAttempts",
            "caption": "Recovery attempts",
            "minimum": 1,
            "maximum": 20
        },
        {
            "type": "NumberSpinner",
            "name": "MessageDuration",
            "caption": "Display duration for temporary messages",
            "suffix": " seconds",
            "minimum": 1,
            "maximum": 60
        },
        {
            "type": "CheckBox",
            "name": "ScrambleKeypad",
            "caption": "Scramble digits (in pattern mode for Super PIN entry only)"
        },
        {
            "type": "NumberSpinner",
            "name": "ScrambleInterval",
            "caption": "Scramble interval while idle (0 = disabled)",
            "suffix": " seconds",
            "minimum": 0,
            "maximum": 3600
        }
    ],
    "actions": [
        {
            "type": "ExpansionPanel",
            "caption": "Register action",
            "items": [
                {
                    "type": "Label",
                    "caption": "Choose a tested script or a visualization target. The script content is copied and stored encrypted."
                },
                {
                    "type": "PasswordTextBox",
                    "name": "Code",
                    "caption": "PIN"
                },
                {
                    "type": "PasswordTextBox",
                    "name": "CodeConfirmation",
                    "caption": "Repeat PIN"
                },
                {
                    "type": "SelectObject",
                    "name": "Target",
                    "caption": "Script or navigation target"
                },
                {
                    "type": "ValidationTextBox",
                    "name": "Parameters",
                    "caption": "Script parameters (JSON object, optional)"
                },
                {
                    "type": "CheckBox",
                    "name": "ShowOutput",
                    "caption": "Show script output on the tile"
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Button",
                            "caption": "Register action",
                            "onClick": "PRACT_UIRegisterAction($id, $Code, $CodeConfirmation, $Target, $Parameters, $ShowOutput);"
                        },
                        {
                            "type": "Button",
                            "caption": "Remove action for this code",
                            "onClick": "PRACT_UIUnregister($id, $Code);"
                        }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Super PIN",
            "items": [
                {
                    "type": "Label",
                    "caption": "The Super PIN is always numeric, can be registered only once and lifts a permanent lock."
                },
                {
                    "type": "PasswordTextBox",
                    "name": "SuperPIN",
                    "caption": "Super PIN"
                },
                {
                    "type": "PasswordTextBox",
                    "name": "SuperPINConfirmation",
                    "caption": "Repeat Super PIN"
                },
                {
                    "type": "Button",
                    "name": "RegisterSuperPIN",
                    "caption": "Register Super PIN",
                    "onClick": "PRACT_UIRegisterSuperPIN($id, $SuperPIN, $SuperPINConfirmation);"
                },
                {
                    "type": "Label",
                    "name": "SuperPINRegistered",
                    "caption": "A Super PIN is registered. Reset the instance to define a new one.",
                    "visible": false
                },
                {
                    "type": "PasswordTextBox",
                    "name": "UnlockPIN",
                    "caption": "Super PIN for unlocking"
                },
                {
                    "type": "Button",
                    "caption": "Unlock",
                    "onClick": "PRACT_UIUnlock($id, $UnlockPIN);"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Reset",
            "items": [
                {
                    "type": "Label",
                    "caption": "Deletes all actions and the Super PIN and releases input mode and code binding."
                },
                {
                    "type": "Button",
                    "caption": "Reset all registrations",
                    "onClick": "PRACT_Reset($id);",
                    "confirm": "Delete all actions and the Super PIN?"
                }
            ]
        }
    ],
    "status": [
        {
            "code": 203,
            "icon": "error",
            "caption": "Module code changed. Re-registration required"
        },
        {
            "code": 202,
            "icon": "error",
            "caption": "Invalid configuration or locked registration options"
        },
        {
            "code": 201,
            "icon": "error",
            "caption": "Sodium extension is not available"
        }
    ]
}
